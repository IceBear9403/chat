  ],
  "properties": [
    {
      "name": "app.auth.mode",
      "type": "java.lang.String",
      "description": "当前生效的认证模式，默认手机验证",
      "sourceType": "com.social.service.config.AppProperties$Auth",
      "defaultValue": "phone"
    },
    {
      "name": "app.compliance.job-enabled",
      "type": "java.lang.Boolean",
      "description": "任务开关：多实例部署时置 false，避免多个实例重复扫描",
      "sourceType": "com.social.service.config.AppProperties$Compliance",
      "defaultValue": true
    },
    {
      "name": "app.jwt.access-expire-seconds",
      "type": "java.lang.Long",
      "description": "access token 有效期（秒），默认 2h",
      "sourceType": "com.social.service.config.AppProperties$Jwt",
      "defaultValue": 7200
    },
    {
      "name": "app.jwt.access-secret",
      "type": "java.lang.String",
      "description": "access token 密钥（>= 32 字符）",
      "sourceType": "com.social.service.config.AppProperties$Jwt"
    },
    {
      "name": "app.jwt.refresh-expire-seconds",
      "type": "java.lang.Long",
      "description": "refresh token 有效期（秒），默认 7d",
      "sourceType": "com.social.service.config.AppProperties$Jwt",
      "defaultValue": 604800
    },
    {
      "name": "app.jwt.refresh-secret",
      "type": "java.lang.String",
      "description": "refresh token 密钥（>= 32 字符，与 access 不同）",
      "sourceType": "com.social.service.config.AppProperties$Jwt"
    },
    {
      "name": "app.mail.enabled",
      "type": "java.lang.Boolean",
      "description": "真实发信开关：true=走 SMTP 发送验证码邮件；false=退回 mock 固定码（本地联调）",
      "sourceType": "com.social.service.config.AppProperties$Mail",
      "defaultValue": true
    },
    {
      "name": "app.mail.from",
      "type": "java.lang.String",
      "description": "发件人地址（通常与 SMTP 账号一致，QQ 邮箱要求与账号相同）",
      "sourceType": "com.social.service.config.AppProperties$Mail",
      "defaultValue": ""
    },
    {
      "name": "app.nickname.banned-prefix",
      "type": "java.lang.String",
      "description": "违禁昵称替换前缀（昵称巡检定时任务用），最终形如 \"违禁昵称<毫秒时间戳>\"",
      "sourceType": "com.social.service.config.AppProperties$Nickname",
      "defaultValue": "违禁昵称"
    },
    {
      "name": "app.nickname.change-interval-days",
      "type": "java.lang.Long",
      "description": "用户自行修改昵称的最小间隔（天），0=不限制。管理员修改昵称不受此限制",
      "sourceType": "com.social.service.config.AppProperties$Nickname",
      "defaultValue": 7
    },
    {
      "name": "app.pii.key",
      "type": "java.lang.String",
      "description": "加密密钥（>=16 字符）。生产用环境变量 APP_PII_KEY 注入，不得落明文",
      "sourceType": "com.social.service.config.AppProperties$Pii",
      "defaultValue": ""
    },
    {
      "name": "app.realname.mock-enabled",
      "type": "java.lang.Boolean",
      "description": "mock 开关：开启时实名直接通过（当前无短信\/实人服务），生产接入后置 false",
      "sourceType": "com.social.service.config.AppProperties$RealName",
      "defaultValue": true
    },
    {
      "name": "app.storage.local-path",
      "type": "java.lang.String",
      "description": "本地文件存储根目录（相对启动目录）。生产切 OSS 后可忽略",
      "sourceType": "com.social.service.config.AppProperties$Storage",
      "defaultValue": ".\/uploads"
    },
    {
      "name": "app.storage.max-file-size-mb",
      "type": "java.lang.Long",
      "description": "单个文件大小上限（MB）",
      "sourceType": "com.social.service.config.AppProperties$Storage",
      "defaultValue": 20
    },
    {
      "name": "app.verify-code.expire-seconds",
      "type": "java.lang.Long",
      "description": "验证码有效期（秒），默认 5min",
      "sourceType": "com.social.service.config.AppProperties$VerifyCode",
      "defaultValue": 300
    },
    {
      "name": "app.verify-code.mock-code",
      "type": "java.lang.String",
      "description": "mock 验证码",
      "sourceType": "com.social.service.config.AppProperties$VerifyCode",
      "defaultValue": "123456"
    },
    {
      "name": "app.verify-code.mock-enabled",
      "type": "java.lang.Boolean",
      "description": "开发阶段 mock 开关：开启后使用固定验证码，不真正发短信",
      "sourceType": "com.social.service.config.AppProperties$VerifyCode",
      "defaultValue": true
    },
    {
      "name": "app.verify-code.sms-sign-name",
      "type": "java.lang.String",
      "description": "短信模板签名（接入阿里云短信后使用）",
      "sourceType": "com.social.service.config.AppProperties$VerifyCode",
      "defaultValue": ""
    },
    {
      "name": "app.verify-code.sms-template-code",
      "type": "java.lang.String",
      "sourceType": "com.social.service.config.AppProperties$VerifyCode",
      "defaultValue": ""
    },
    {
      "name": "app.webrtc.ice-servers",
      "type": "java.util.List<com.social.service.config.AppProperties$IceServer>",
      "description": "ICE 服务器，格式 [{urls, username, credential}]",
      "sourceType": "com.social.service.config.AppProperties$Webrtc"
    }
  ],
  "hints": []
}