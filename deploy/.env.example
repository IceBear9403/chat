# =============================================================
# 阶段六：环境变量示例
# 用法：cp .env.example .env 后逐项修改，deploy.sh 读取 .env
# 说明：所有密钥类请用强随机值，不要使用示例值
# =============================================================

# ---------- 服务器 / 域名 ----------
# ECS 公网 IP（coturn external-ip 必填，同时用于部署提示）
ECS_PUBLIC_IP=你的ECS公网IP
# 已解析到 ECS 的域名（Nginx server_name + coturn realm + 证书名）
DOMAIN=你的域名.com

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=请改强随机密码
MYSQL_USER=social
MYSQL_PASSWORD=请改强随机密码

# ---------- Redis ----------
REDIS_PASSWORD=请改强随机密码

# ---------- JWT（>=32 字符，两把不同密钥） ----------
JWT_ACCESS_SECRET=请改32字符以上的随机字符串A
JWT_REFRESH_SECRET=请改32字符以上的随机字符串B

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=https://你的域名.com

# ---------- 验证码（阶段六 mock，阶段七接短信后置 false 并配 SMS） ----------
VERIFY_CODE_MOCK=true
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- TURN / STUN（coturn 静态凭据） ----------
# 留空则前端退化为公共 STUN（P2P 直连），填了则跨 NAT 也可中继
TURN_URL=turn:你的域名.com:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=请改强随机密码
