# =============================================================
# 阶段六：环境变量示例
# 用法：cp .env.example .env 后逐项修改，deploy.sh 读取 .env
# 说明：所有密钥类请用强随机值，不要使用示例值
# =============================================================

# ---------- 服务器 / 域名 ----------
# ECS 公网 IP（coturn external-ip 必填，同时用于部署提示）
ECS_PUBLIC_IP=你的ECS公网IP
# 已解析到 ECS 的域名（Nginx server_name + coturn realm + 证书名）
DOMAIN=你的域名.com

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=请改强随机密码
MYSQL_USER=social
MYSQL_PASSWORD=请改强随机密码

# ---------- Redis ----------
REDIS_PASSWORD=请改强随机密码

# ---------- JWT（>=32 字符，两把不同密钥） ----------
JWT_ACCESS_SECRET=请改32字符以上的随机字符串A
JWT_REFRESH_SECRET=请改32字符以上的随机字符串B

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=https://你的域名.com

# ---------- 验证码（阶段六 mock，阶段七接短信后置 false 并配 SMS） ----------
VERIFY_CODE_MOCK=true
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 认证模式：phone=手机验证（默认），email=邮箱验证。手机验证代码保留，改这里即可切换
AUTH_MODE=phone
# 昵称修改间隔（天，0=不限制）；管理员修改任意用户昵称不受此限制
NICKNAME_CHANGE_INTERVAL_DAYS=7

# ---------- 阶段七合规 ----------
# PII 加密密钥（>=16 字符）。手机号/姓名/身份证用此密钥 AES-GCM 加密，
# 一旦上线变更密钥，历史密文将无法解密！请妥善保管（如放进云 KMS 或密码库）。
APP_PII_KEY=请改16字符以上的随机密钥
# 实名认证 mock（接入阿里云实人认证后置 false）
REALNAME_MOCK=true
# 合规定时任务（日志清理/敏感词巡检；多实例扩展时仅主实例 true）
COMPLIANCE_JOB_ENABLED=true

# ---------- 邮箱验证（AUTH_MODE=email 时配置；MAIL_PASSWORD 填邮箱 SMTP 授权码，非登录密码） ----------
# 服务商对应 SMTP：QQ=smtp.qq.com:465，163=smtp.163.com:465，126=smtp.126.com:465
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=你的邮箱地址（如 xxx@qq.com）
MAIL_PASSWORD=你的邮箱SMTP授权码（非邮箱登录密码）
MAIL_FROM=你的邮箱地址
# 邮箱验证码真实发信开关：true=SMTP 发信；false=退回 mock 固定码（联调）
MAIL_ENABLED=false

# ---------- TURN / STUN（coturn 静态凭据） ----------
# 留空则前端退化为公共 STUN（P2P 直连），填了则跨 NAT 也可中继
TURN_URL=turn:你的域名.com:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=请改强随机密码
